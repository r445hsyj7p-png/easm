# =============================================================================
# Dockerfile.worker — Celery Worker
# Enthält: nuclei, subfinder, httpx, naabu, Python, alle Dependencies
# theHarvester: native Python implementation (dnspython + requests) — kein Binary
# =============================================================================

# Runtime base
FROM python:3.11-slim

# System tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    unzip \
    git \
    dnsutils \
    nmap \
    libpq-dev \
    gcc \
    ca-certificates \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Download all projectdiscovery binaries from GitHub releases (architecture-aware).
# Copying from the nuclei Docker image caused ELF/libc mismatches because that
# image is Alpine-based while this runtime is Debian (different dynamic linker path).
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
      amd64) GOARCH=amd64 ;; \
      arm64) GOARCH=arm64 ;; \
      *) GOARCH=amd64 ;; \
    esac && \
    # nuclei
    wget -qO /tmp/nuclei.zip \
      "https://github.com/projectdiscovery/nuclei/releases/download/v3.3.1/nuclei_3.3.1_linux_${GOARCH}.zip" && \
    unzip -q /tmp/nuclei.zip -d /tmp/nuclei && \
    mv /tmp/nuclei/nuclei /usr/local/bin/nuclei && \
    chmod +x /usr/local/bin/nuclei && \
    # subfinder
    wget -qO /tmp/subfinder.zip \
      "https://github.com/projectdiscovery/subfinder/releases/download/v2.6.6/subfinder_2.6.6_linux_${GOARCH}.zip" && \
    unzip -q /tmp/subfinder.zip -d /tmp/subfinder && \
    mv /tmp/subfinder/subfinder /usr/local/bin/subfinder && \
    chmod +x /usr/local/bin/subfinder && \
    # httpx
    wget -qO /tmp/httpx.zip \
      "https://github.com/projectdiscovery/httpx/releases/download/v1.6.6/httpx_1.6.6_linux_${GOARCH}.zip" && \
    unzip -q /tmp/httpx.zip -d /tmp/httpx && \
    mv /tmp/httpx/httpx /usr/local/bin/httpx && \
    chmod +x /usr/local/bin/httpx && \
    # naabu
    wget -qO /tmp/naabu.zip \
      "https://github.com/projectdiscovery/naabu/releases/download/v2.3.1/naabu_2.3.1_linux_${GOARCH}.zip" && \
    unzip -q /tmp/naabu.zip -d /tmp/naabu && \
    mv /tmp/naabu/naabu /usr/local/bin/naabu && \
    chmod +x /usr/local/bin/naabu && \
    rm -rf /tmp/nuclei* /tmp/subfinder* /tmp/httpx* /tmp/naabu*

# Python dependencies
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# ramparts is worker-only and may not be on PyPI — install best-effort
RUN pip install --no-cache-dir ramparts || echo "ramparts not available on PyPI, skipping"

# App code — CACHEBUST=20260522-2
COPY . .

# Entrypoint
COPY scripts/entrypoint-worker.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["celery", "-A", "workers.toolchain_tasks", "worker", \
     "--loglevel=info", "--concurrency=4"]
